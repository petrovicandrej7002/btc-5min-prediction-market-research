# Copy to .env and fill in your own values. Never commit .env.

# Key of the wallet that signs orders
PRIVATE_KEY=
# Polymarket proxy wallet that holds the funds
FUNDER_ADDRESS=
# Polymarket API credentials
API_KEY=
API_SECRET=
PASSPHRASE=

# Optional, defaults shown
# KILL_LOW=0.20
# KILL_HIGH=0.80
# gap_test: cycles per gap and the gaps in ms
# CYCLES=10
# GAPS=10,5,3,1,0
# freq_test: number of cycles and a pause after each one in ms
# MAX_CYCLES=100
# THROTTLE_MS=0
